    {"id": 1213, "id_card": 1027, "texto": "Se requiere que existan controles de paginación (primero, anterior, siguiente y último) para navegar entre los registros disponibles, estos controles se encontraran debajo de la tabla.", "hecho": true, "autor": "Brandom12@", "fecha_alta": "2026-06-01 17:01:36"},
    {"id": 1214, "id_card": 1027, "texto": "Se requiere que en la parte superior de la tabla se localize un botón con un signo de \"más\". Necesito que, al dar click en el botón de \"más\", se abra una ventana para registrar un nuevo apoderado.", "hecho": true, "autor": "Brandom12@", "fecha_alta": "2026-06-01 17:01:36"},
