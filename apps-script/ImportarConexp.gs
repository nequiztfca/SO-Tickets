const IMP_ORDEN = ['sistemas', 'modulos', 'cards', 'bloques', 'checklist', 'comentarios'];
const IMP_CATALOGO = ['sistemas', 'modulos'];          // se saltan los que ya existen

/** Solo revisa: no escribe nada */
function probarImportacion() { impPlan_(true); }

/** Revisa y agrega a las hojas lo que falta */
function importarConexp() {
  withLock_(() => {
    const plan = impPlan_(false);
    IMP_ORDEN.forEach(col => appendRows_(col, plan[col]));
    Logger.log('✅ Importado: ' + IMP_ORDEN.map(c => plan[c].length + ' ' + c).join(', '));
  });
}

/** Calcula qué filas se agregan y detiene todo si hay choques o referencias rotas */
function impPlan_(soloRevisar) {
  const plan = {}, problemas = [], saltados = [];
  IMP_ORDEN.forEach(col => {
    const ya = {}; readAll_(col).forEach(r => { ya[r.id] = true; });
    const filas = IMP_DATOS[col] || [];
    if (IMP_CATALOGO.indexOf(col) >= 0) {
      plan[col] = filas.filter(r => !ya[Number(r.id)]);
      if (filas.length - plan[col].length) saltados.push((filas.length - plan[col].length) + ' ' + col + ' ya existían');
    } else {
      const choques = filas.filter(r => ya[Number(r.id)]).map(r => r.id);
      if (choques.length) problemas.push(col + ': ya existen los id ' + choques.slice(0, 10).join(', ') + (choques.length > 10 ? '…' : '') + ' (¿ya lo importaste?)');
      plan[col] = filas;
    }
  });
  // Referencias: cada subsistema a un sistema, cada card a un subsistema, cada bloque/tarea/comentario a una card
  const ids = col => { const o = {}; readAll_(col).concat(plan[col]).forEach(r => { o[Number(r.id)] = true; }); return o; };
  const sis = ids('sistemas'), mods = ids('modulos'), cards = ids('cards');
  const rotas = (col, campo, ok) => plan[col].filter(r => !ok[Number(r[campo])]).map(r => r.id);
  [['modulos', 'id_sistema', sis], ['cards', 'id_modulo', mods], ['bloques', 'id_card', cards], ['checklist', 'id_card', cards], ['comentarios', 'id_card', cards]]
    .forEach(([col, campo, ok]) => { const r = rotas(col, campo, ok); if (r.length) problemas.push(col + ' con ' + campo + ' inexistente: ' + r.slice(0, 10).join(', ')); });
  if (problemas.length) throw new Error('No se importó nada:\n- ' + problemas.join('\n- '));
  Logger.log((soloRevisar ? '🔎 Todo listo para importar: ' : 'Revisión correcta: ') +
    IMP_ORDEN.map(c => plan[c].length + ' ' + c).join(', ') + (saltados.length ? ' · ' + saltados.join(', ') : ''));
  return plan;
}
