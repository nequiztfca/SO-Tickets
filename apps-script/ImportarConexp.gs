    {"id": 1081, "id_card": 1022, "texto": "El trabajador requiere que exista una pantalla llamada “Gestión de Salas” para administrar la disponibilidad y control de las salas en la asignación de expedientes.", "hecho": true, "autor": "Brandom12@", "fecha_alta": "2026-05-20 19:42:52"},
    {"id": 1082, "id_card": 1022, "texto": "Necesito visualizar una tabla con los siguientes apartados:", "hecho": true, "autor": "Brandom12@", "fecha_alta": "2026-05-20 19:42:52"},
