    {"id": 1063, "id_card": 1021, "texto": "[Criterios de aceptación] Requiero que exista una pantalla llamada “Certificación de Expedientes o Registro Sindical” para consultar la información relacionada con la certificación de expedientes.", "hecho": true, "autor": "Brandom12@", "fecha_alta": "2026-05-20 19:42:43"},
