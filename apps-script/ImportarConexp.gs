    {"id": 1054, "id_card": 1030, "tipo": "texto", "contenido": "Revisar el error en \"Acciones demandadas\" al momento de guardar la acción demandada nos muestra un error, pero al momento de salir de la ventana se muestra la acción demandada. Tambien puede aparecer duplicada", "lenguaje": "", "fileName": "", "mime": "", "size": 0, "url": "", "fileId": "", "orden": 1},
