    {"id": 1084, "id_card": 1022, "texto": "La tabla deberá divirse en 3 secciones:   -Salas   -Directos   -Convenios", "hecho": true, "autor": "Brandom12@", "fecha_alta": "2026-05-20 19:42:52"},
