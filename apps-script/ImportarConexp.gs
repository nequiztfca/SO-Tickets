    {"id": 1089, "id_card": 1022, "texto": "Requiero que cuando el botón de \"Estatus Sala\" sea desactivado, la sala ya no aparezca disponible al momento de realizar una ronda de asignación de expedientes.", "hecho": true, "autor": "Brandom12@", "fecha_alta": "2026-05-20 19:42:52"},
    {"id": 1090, "id_card": 1022, "texto": "\"Ronda\": será para visualizar el número de ronda en la que se encuentra actualmente al terminar de asignarse los expedientes a todas las salas disponibles", "hecho": true, "autor": "Brandom12@", "fecha_alta": "2026-05-20 19:42:52"},
    {"id": 1091, "id_card": 1022, "texto": "\"Total\": para mostrar la cantidad total de expedientes asignados a cada sala mediante una barra o indicador visual.", "hecho": true, "autor": "Brandom12@", "fecha_alta": "2026-05-20 19:42:52"},
