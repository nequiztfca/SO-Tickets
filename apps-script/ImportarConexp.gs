    {"id": 1263, "id_card": 1029, "texto": "Tambien debe de haber un campo el cual permita seleccionar la cantidad de registros de las acciones demandas a mostrar por página por medio de un catálogo.", "hecho": true, "autor": "Brandom12@", "fecha_alta": "2026-06-01 17:02:23"},
    {"id": 1264, "id_card": 1029, "texto": "Necesito que arriba de la tabla aparezca un botón con un signo de \"+\", al darle click abrirá una ventana para registrar una nueva acción demandada con los siguientes campos:", "hecho": true, "autor": "Brandom12@", "fecha_alta": "2026-06-01 17:02:23"},
